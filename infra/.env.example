# ============================================================
# Wearables Platform – Deployment Configuration
# Copy to infra/.env and fill in your values.
# NEVER commit infra/.env to Git.
# ============================================================

# ------ Hetzner Cloud ----------------------------------------
HCLOUD_TOKEN="your-hetzner-cloud-api-token"

# Server config (see infra/terraform/variables.tf for options)
TF_SERVER_NAME="k3s-wearables"
TF_SERVER_TYPE="cx31"          # cx21=2vCPU/4GB, cx31=2vCPU/8GB, cx41=4vCPU/16GB
TF_LOCATION="nbg1"             # nbg1=Nürnberg, fsn1=Falkenstein, hel1=Helsinki

# ------ SSH --------------------------------------------------
# Your local SSH key that will be added to the server
SSH_KEY_PATH="$HOME/.ssh/id_ed25519"
SSH_PUBLIC_KEY_PATH="$HOME/.ssh/id_ed25519.pub"
# Your username on the server (must match one in ansible/playbook.yml users list)
SSH_USER="rknntns"

# ------ Application Secrets ----------------------------------
# JWT secret shared across importservice, wearables-bff, grafana-proxy
# Leave empty to auto-generate a random one on first deploy
SHARED_APP_JWT_SECRET=""

# Brevo (Sendinblue) API key for BFF email sending (optional)
BREVO_API_KEY=""

# Researcher API access token (required for BFF)
RESEARCHER_API_ACCESS_TOKEN=""

# Path to Grafana JWT private key PEM file (required for grafana-proxy)
GRAFANA_JWT_PRIVATE_KEY_PATH="./secrets/grafana-jwt-private.pem"

# ------ Postgres passwords -----------------------------------
# Dev postgres (gitops/apps/platform/postgres)
POSTGRES_DEV_PASSWORD=""       # Leave empty to auto-generate

# Prod postgres (gitops/apps/platform/prod-postgres)
POSTGRES_PROD_PASSWORD=""      # Leave empty to auto-generate

# ------ Grafana ----------------------------------------------
GRAFANA_ADMIN_PASSWORD=""      # Leave empty to auto-generate

# ------ InfluxDB ---------------------------------------------
INFLUX_ADMIN_PASSWORD=""       # Leave empty to auto-generate
INFLUX_ADMIN_TOKEN=""          # Leave empty to auto-generate

# ------ Domain -----------------------------------------------
DOMAIN="wearables.charite.de"
CERT_EMAIL="admin@charite.de"  # Let's Encrypt notification email
