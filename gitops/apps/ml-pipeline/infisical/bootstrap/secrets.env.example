# =============================================================================
# ML Pipeline — Infisical Bootstrap Secrets
# =============================================================================
# Copy this file to secrets.env (gitignored), fill in any values that need
# changing, then run:
#
#   ./infisical/bootstrap.sh
#
# All keys live in a single flat path "/" in the "prod" environment.
# Every InfisicalSecret CRD syncs the full set; each service reads only
# the keys it needs via secretKeyRef / envFrom.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL setup (postgres-setup-secrets)
# -----------------------------------------------------------------------------
PGPASSWORD=CHANGE_ME
LAKEFS_PASS=CHANGE_ME
SEAWEEDFS_PASS=CHANGE_ME
MLFLOW_PASS=CHANGE_ME
FEAST_PASS=CHANGE_ME

# -----------------------------------------------------------------------------
# SeaweedFS S3 identity config (seaweedfs-s3-secret)
# Single key whose value is the full JSON config consumed by SeaweedFS.
# -----------------------------------------------------------------------------
seaweedfs_s3_config={"identities":[{"name":"admin","credentials":[{"accessKey":"CHANGE_ME","secretKey":"CHANGE_ME"}],"actions":["Admin","Read","Write","List","Tagging"]},{"name":"readonly","credentials":[{"accessKey":"CHANGE_ME","secretKey":"CHANGE_ME"}],"actions":["Read","List"]},{"name":"lakefs","credentials":[{"accessKey":"CHANGE_ME","secretKey":"CHANGE_ME"}],"actions":["Read","Write","List","Tagging"]},{"name":"mlflow","credentials":[{"accessKey":"CHANGE_ME","secretKey":"CHANGE_ME"}],"actions":["Read","Write","List","Tagging"]},{"name":"spark","credentials":[{"accessKey":"CHANGE_ME","secretKey":"CHANGE_ME"}],"actions":["Read","Write","List","Tagging"]}]}

# -----------------------------------------------------------------------------
# SeaweedFS PostgreSQL credentials (seaweedfs-postgres-secret)
# -----------------------------------------------------------------------------
WEED_POSTGRES_USERNAME=seaweedfs_user
WEED_POSTGRES_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# LakeFS (lakefs-secrets)
# -----------------------------------------------------------------------------
auth_encrypt_secret_key=CHANGE_ME
database_connection_string=postgres://lakefs_user:CHANGE_ME@prod-postgres.prod-postgres.svc.cluster.local:5432/lakefs
s3_access_key=CHANGE_ME
s3_secret_key=CHANGE_ME
lakefs_s3_access_key=CHANGE_ME
lakefs_s3_secret_key=CHANGE_ME
lakefs_first_user_display_name=MyAdmin

# -----------------------------------------------------------------------------
# MLflow (mlflow-secrets)
# -----------------------------------------------------------------------------
POSTGRES_HOST=prod-postgres.prod-postgres.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
MLFLOW_S3_ENDPOINT_URL=http://seaweedfs-s3.ml-pipeline-seaweedfs.svc.cluster.local:8333

# -----------------------------------------------------------------------------
# Feast (feast-secrets)
# -----------------------------------------------------------------------------
FEAST_DB_HOST=prod-postgres.prod-postgres.svc.cluster.local
FEAST_DB_PORT=5432
FEAST_DB_NAME=feast
FEAST_DB_USER=feast_user
FEAST_DB_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Spark pipeline (spark-pipeline-secrets)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://seaweedfs-s3.ml-pipeline-seaweedfs.svc.cluster.local:8333
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
LAKEFS_ENDPOINT=http://lakefs.ml-pipeline-lakefs.svc.cluster.local:80
LAKEFS_ACCESS_KEY=CHANGE_ME
LAKEFS_SECRET_KEY=CHANGE_ME
KAFKA_BOOTSTRAP_SERVERS=kafka-kafka-bootstrap.kafka.svc.cluster.local:9092
KAFKA_TOPIC=wearables-lp
INFLUX_URL=http://influxdb-service.influx.svc.cluster.local:8086
INFLUX_TOKEN=CHANGE_ME
INFLUX_ORG=wearables-project
INFLUX_BUCKET=ml_predictions
MLFLOW_TRACKING_URI=http://mlflow-tracking.ml-pipeline-mlflow.svc.cluster.local:5000
MODEL_NAME=heart_rate_model
MODEL_STAGE=Production
FEAST_REPO_PATH=/opt/spark/work-dir/feature_repo

# -----------------------------------------------------------------------------
# KServe (kserve-s3-secret)
# Reuses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY defined above under MLflow.
# -----------------------------------------------------------------------------
