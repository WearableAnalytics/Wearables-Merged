# Copy to cluster.env (git-ignored) or point CLUSTER_ENV at a copy outside the repo.
KKP_CLUSTER_ID=xxxxxxxxxx          # Kubermatic cluster ID
KKP_PROJECT_ID=xxxxxxxxxx          # Kubermatic project ID
OS_SUBNET_ID=00000000-0000-0000-0000-000000000000   # OpenStack subnet of network kubernetes-<cluster ID>
SSH_KEYS_DIR=                      # optional: dir with <pool>.json, a JSON list of SSH public keys per pool
