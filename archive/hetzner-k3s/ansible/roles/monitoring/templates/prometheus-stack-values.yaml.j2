# Helm values for kube-prometheus-stack
# Generated by Ansible

global:
  rbac:
    create: true

prometheusOperator:
  enabled: true
  resources:
    limits:
      memory: 512Mi
      cpu: 200m
    requests:
      memory: 256Mi
      cpu: 100m

prometheus:
  enabled: true

  prometheusSpec:
    resources:
      requests:
        memory: {{ prometheus_requests_memory }}
        cpu: {{ prometheus_requests_cpu }}
      limits:
        memory: {{ prometheus_limits_memory }}
        cpu: {{ prometheus_limits_cpu }}

    retention: {{ prometheus_retention }}
    retentionSize: "{{ prometheus_retention_size }}"

    scrapeInterval: {{ scrape_interval }}
    evaluationInterval: {{ evaluation_interval }}

    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: {{ prometheus_storage_size }}

    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      fsGroup: 2000

    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false

  service:
    type: ClusterIP
    port: 9090

alertmanager:
  enabled: true

  alertmanagerSpec:
    resources:
      requests:
        memory: {{ alertmanager_requests_memory }}
        cpu: {{ alertmanager_requests_cpu }}
      limits:
        memory: {{ alertmanager_limits_memory }}
        cpu: {{ alertmanager_limits_cpu }}

    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: {{ alertmanager_storage_size }}

    securityContext:
      runAsNonRoot: true
      runAsUser: 1000
      fsGroup: 2000

    configSecret: alertmanager-config

  service:
    type: ClusterIP
    port: 9093

grafana:
  enabled: true

  admin:
    existingSecret: grafana-admin-credentials
    userKey: admin-user
    passwordKey: admin-password

  resources:
    requests:
      memory: {{ grafana_requests_memory }}
      cpu: {{ grafana_requests_cpu }}
    limits:
      memory: {{ grafana_limits_memory }}
      cpu: {{ grafana_limits_cpu }}

  persistence:
    enabled: true
    type: pvc
    storageClassName: {{ storage_class }}
    accessModes:
      - ReadWriteOnce
    size: {{ grafana_storage_size }}

  service:
    type: ClusterIP
    port: 80

  securityContext:
    runAsNonRoot: true
    runAsUser: 472
    fsGroup: 472

  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: Prometheus
          type: prometheus
          url: http://prometheus-operated:9090
          access: proxy
          isDefault: true
          editable: false

  dashboardProviders:
    dashboardproviders.yaml:
      apiVersion: 1
      providers:
        - name: 'default'
          orgId: 1
          folder: ''
          type: file
          disableDeletion: false
          editable: true
          options:
            path: /var/lib/grafana/dashboards/default

  dashboards:
    default:
{% for dashboard in grafana_dashboards %}
      {{ dashboard.name }}:
        gnetId: {{ dashboard.id }}
        revision: {{ dashboard.revision }}
        datasource: Prometheus
{% endfor %}

nodeExporter:
  enabled: true

kubeStateMetrics:
  enabled: true

defaultRules:
  create: true
  rules:
    alertmanager: true
    etcd: true
    general: true
    k8s: true
    kubeApiserver: true
    kubeApiserverAvailability: true
    kubeApiserverSlos: true
    kubelet: true
    kubePrometheusGeneral: true
    kubePrometheusNodeRecording: true
    kubernetesApps: true
    kubernetesResources: true
    kubernetesStorage: true
    kubernetesSystem: true
    kubeScheduler: true
    kubeStateMetrics: true
    network: true
    node: true
    prometheus: true
    prometheusOperator: true

additionalPrometheusRulesMap:
  custom-alerts:
    groups:
      - name: custom.rules
        interval: 30s
        rules:
          - alert: NodeDown
            expr: up{job="node-exporter"} == 0
            for: {{ alert_node_down_threshold }}
            labels:
              severity: critical
            annotations:
              summary: "Node {{ '{{' }} $labels.instance {{ '}}' }} is down"
              description: "Node {{ '{{' }} $labels.instance {{ '}}' }} has been down for more than {{ alert_node_down_threshold }}"

          - alert: HighMemoryUsage
            expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > {{ alert_memory_threshold }}
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "High memory usage on {{ '{{' }} $labels.instance {{ '}}' }}"
              description: "Memory usage is above {{ alert_memory_threshold }}% on {{ '{{' }} $labels.instance {{ '}}' }} (current: {{ '{{' }} $value {{ '}}' }}%)"

          - alert: HighCPUUsage
            expr: 100 - (avg by(instance) (irate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > {{ alert_cpu_threshold }}
            for: 10m
            labels:
              severity: warning
            annotations:
              summary: "High CPU usage on {{ '{{' }} $labels.instance {{ '}}' }}"
              description: "CPU usage is above {{ alert_cpu_threshold }}% on {{ '{{' }} $labels.instance {{ '}}' }} (current: {{ '{{' }} $value {{ '}}' }}%)"

          - alert: PodCrashLooping
            expr: rate(kube_pod_container_status_restarts_total[15m]) > 0
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "Pod {{ '{{' }} $labels.namespace {{ '}}' }}/{{ '{{' }} $labels.pod {{ '}}' }} is crash looping"
              description: "Pod {{ '{{' }} $labels.namespace {{ '}}' }}/{{ '{{' }} $labels.pod {{ '}}' }} is restarting frequently"

          - alert: LowDiskSpace
            expr: (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}) * 100 < {{ alert_disk_threshold }}
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "Low disk space on {{ '{{' }} $labels.instance {{ '}}' }}"
              description: "Disk space is below {{ alert_disk_threshold }}% on {{ '{{' }} $labels.instance {{ '}}' }} (current: {{ '{{' }} $value {{ '}}' }}%)"

          - alert: PersistentVolumeError
            expr: kube_persistentvolume_status_phase{phase=~"Failed|Pending"} == 1
            for: 5m
            labels:
              severity: critical
            annotations:
              summary: "PersistentVolume {{ '{{' }} $labels.persistentvolume {{ '}}' }} has issues"
              description: "PersistentVolume {{ '{{' }} $labels.persistentvolume {{ '}}' }} is in {{ '{{' }} $labels.phase {{ '}}' }} state"
