# Server
PORT=3002
PROXY_PREFIX=/grafana

# Registration service session validation
SESSION_COOKIE_NAME=jwt
APP_JWT_SECRET=dev-secret

# Grafana target
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_PATH_PREFIX=
GRAFANA_TLS_SKIP_VERIFY=false

# Grafana JWT (used by Grafana to verify users)
GRAFANA_JWT_HEADER=X-JWT-Assertion
GRAFANA_JWT_KEY_ID=grafana-proxy
GRAFANA_JWT_ISSUER=https://wearables.example.com
GRAFANA_JWT_AUDIENCE=grafana
GRAFANA_JWT_TTL_SECONDS=300
GRAFANA_DEFAULT_ROLE=Viewer
GRAFANA_ORG_ID=

# Provide a PEM-encoded private key (RS256)
# GRAFANA_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GRAFANA_JWT_PRIVATE_KEY_PATH=/path/to/grafana-jwt-private.pem
