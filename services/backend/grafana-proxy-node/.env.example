# Server
PORT=3002

# Grafana target
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_PATH_PREFIX=
GRAFANA_TLS_SKIP_VERIFY=false

# JWT auth (required)
# Use either GRAFANA_JWT_PRIVATE_KEY or GRAFANA_JWT_PRIVATE_KEY_PATH
GRAFANA_JWT_PRIVATE_KEY_PATH=../../secrets/grafana-jwt-private.pem
GRAFANA_JWT_HEADER=X-JWT-Assertion
# Optional prefix for JWT header value, e.g. Bearer
GRAFANA_JWT_HEADER_VALUE_PREFIX=
GRAFANA_JWT_ISSUER=wearables-grafana-proxy
GRAFANA_JWT_AUDIENCE=grafana
GRAFANA_JWT_TTL_SECONDS=300
# Backdate iat to tolerate clock skew (seconds).
GRAFANA_JWT_IAT_SKEW_SECONDS=0
GRAFANA_JWT_SUBJECT=wearables-proxy
GRAFANA_JWT_EMAIL=
GRAFANA_JWT_NAME=
GRAFANA_JWT_ROLE=Viewer
GRAFANA_ORG_ID=1

# Dashboard defaults used by /grafana/embed (frontend sends only deviceId).
GRAFANA_DASHBOARD_ID=wearables-health-real
GRAFANA_DASHBOARD_DATASOURCE=dfa4opgnfgg00e

PROXY_PREFIX=/grafana

# Session cookie validation (optional, but recommended for per-user Grafana JWTs)
SESSION_COOKIE_NAME=jwt
APP_JWT_SECRET=dev-secret
