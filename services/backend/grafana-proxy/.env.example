# Server
PORT=3002

# Grafana target
GRAFANA_BASE_URL=https://wearables.charite.de/grafana
GRAFANA_PATH_PREFIX=
GRAFANA_TLS_SKIP_VERIFY=false

# JWT auth (required)
# Use either GRAFANA_JWT_PRIVATE_KEY or GRAFANA_JWT_PRIVATE_KEY_PATH
GRAFANA_JWT_PRIVATE_KEY_PATH=../../../secrets/grafana-jwt-private.pem

GRAFANA_JWT_HEADER=X-JWT-Assertion
GRAFANA_JWT_ISSUER=wearables-grafana-proxy
GRAFANA_JWT_AUDIENCE=grafana
GRAFANA_JWT_TTL_SECONDS=300
GRAFANA_JWT_IAT_SKEW_SECONDS=120
GRAFANA_JWT_SUBJECT=wearables-proxy
GRAFANA_JWT_EMAIL=admin@localhost
GRAFANA_JWT_NAME=
GRAFANA_JWT_ROLE=Viewer
GRAFANA_ORG_ID=1

# Comma-separated list of dashboard UIDs allowed via /grafana/embed?dashboardUid=<uid>
GRAFANA_ALLOWED_DASHBOARD_IDS=wearables-health-real,wearables-six-min
GRAFANA_DASHBOARD_DATASOURCE=dfa4opgnfgg00e

PROXY_PREFIX=/grafana

# Registration service session validation
SESSION_COOKIE_NAME=jwt
APP_JWT_SECRET=dev-secret

# Grafana JWT (used by Grafana to verify users)
GRAFANA_JWT_KEY_ID=grafana-proxy
GRAFANA_DEFAULT_ROLE=Viewer