# Server
PORT=3002

# Grafana target
GRAFANA_BASE_URL=https://wearables.charite.de
GRAFANA_PATH_PREFIX=/grafana
GRAFANA_TLS_SKIP_VERIFY=false

# JWT auth (required)
# Use either GRAFANA_JWT_PRIVATE_KEY or GRAFANA_JWT_PRIVATE_KEY_PATH
GRAFANA_JWT_PRIVATE_KEY_PATH=../../../secrets/grafana-jwt-private.pem

GRAFANA_JWT_HEADER=X-JWT-Assertion
GRAFANA_JWT_ISSUER=wearables-grafana-proxy
GRAFANA_JWT_AUDIENCE=grafana
GRAFANA_JWT_TTL_SECONDS=300
GRAFANA_JWT_IAT_SKEW_SECONDS=120
GRAFANA_ORG_ID=1

# Comma-separated list of dashboard UIDs allowed via <PROXY_PREFIX>/embed?dashboardUid=<uid>
GRAFANA_ALLOWED_DASHBOARD_IDS=wearables-health-real,wearables-six-min
GRAFANA_DASHBOARD_DATASOURCE=dfa4opgnfgg00e

PROXY_PREFIX=/grafana

# Wearables app JWT validation (session cookie + embed case token issuer)
APP_JWT_SECRET=dev-secret
APP_JWT_ISSUER=wearables-bff
