# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api

# Frontend Configuration
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# JWT Configuration
JWT_SECRET=dev-secret

# External Database API Configuration
DATABASE_API_URL=http://localhost:8000
DATABASE_API_TIMEOUT=30000

# Feature Flag - set to true to use mock data instead of real API
USE_MOCK_DATA=true
