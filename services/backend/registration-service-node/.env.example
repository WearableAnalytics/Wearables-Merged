# Server Configuration
PORT=3001
NODE_ENV=development # set to 'production' in production environments
API_PREFIX=/api

# Frontend Configuration
FRONTEND_URL=http://localhost:8080

# Backend Configuration
BACKEND_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=dev-secret

# External Database API Configuration
DATABASE_API_URL=http://localhost:8000
DATABASE_API_TIMEOUT=30000

# Feature Flag - set to true to use mock data instead of real API
USE_MOCK_DATA=true

# Mailer Configuration
MAILER_ENABLED=false # Set to true to enable email sending
MAILER_FROM_NAME=Wearables Platform
MAILER_FROM_EMAIL=email@example.com # Email address used in the 'From' field, must be a verified sender in Brevo
BREVO_API_KEY=
