# Development binds to 127.0.0.1. Configure exact URLs for your local web proxy.
PORT=3001
NODE_ENV=development
API_PREFIX=/api
FRONTEND_ORIGINS=http://127.0.0.1:5173
FRONTEND_REDIRECT_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:3001

# Fresh private signing/workload secrets; never commit real values.
JWT_SECRET=
CONTROL_WRITE_TOKEN=
API_TOKEN_SERVICE_TOKEN=
AUTH_SESSION_EXPIRY_SECONDS=3600
TOKEN_ISSUER=wearables-bff
COOKIE_SECURE=false

# Always use persistent authority. Production requires HTTPS to this API.
DATABASE_API_URL=http://127.0.0.1:8000
DATABASE_API_TIMEOUT=5000
USE_MOCK_DATA=false
LOG_LEVEL=info

# Broad exports are blocked pending a separate case-scoped export feature.
EXTRACTION_API_URL=
# No admin/password bootstrap, email-delivery or dev-bypass setting belongs here.
# Use db_lord's protected bootstrap_admin command to initialize the first named admin.
