# Development example. Use distinct private secrets; never commit actual values.
PORT=3001
NODE_ENV=development
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_REDIRECT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
JWT_SECRET=
TOKEN_ISSUER=wearables-bff
AUTH_SESSION_EXPIRY_SECONDS=3600
MAGIC_LINK_EXPIRY_SECONDS=600
COOKIE_SECURE=false
ADMIN_EMAILS=admin@example.test
CONTROL_WRITE_TOKEN=
API_TOKEN_SERVICE_TOKEN=
# Must match db_lord LEGACY_OPERATOR_TOKEN; distinct from the control/token-service secrets.
DATABASE_OPERATOR_TOKEN=
DATABASE_API_URL=http://localhost:8000
DATABASE_API_TIMEOUT=5000
# Private extraction backend. BFF enforces the existing researcher/admin/token access rules.
EXTRACTION_API_URL=
USE_MOCK_DATA=false
LOG_LEVEL=info
# Explicit local email-proof shortcut only. Development does not send email.
ALLOW_DEV_AUTH_BYPASS=false
# Configure only the actual trusted ingress IPs/CIDRs; otherwise leave empty.
TRUSTED_PROXY_CIDRS=
# Required for production email login; production browser/database URLs must use HTTPS.
MAILER_FROM_NAME=Wearables Platform
MAILER_FROM_EMAIL=sender@example.com
BREVO_API_KEY=
