# Server Configuration
PORT=3001
# Set to `production` in production environments
NODE_ENV=development
API_PREFIX=/api

# Frontend Configuration
# Required: allowed CORS origins (comma-separated). No fallback.
FRONTEND_ORIGINS=https://frontend.example.com
# Required: single frontend base URL for redirects (magic link + approval/login links). No fallback.
FRONTEND_REDIRECT_URL=https://frontend.example.com

# Backend Configuration
# Required: absolute backend URL used to build magic-link verification links. No fallback.
BACKEND_URL=https://api.example.com

# JWT Configuration
# Required in every environment. Must never be `dev-secret` in production.
# Keep in sync with grafana-proxy APP_JWT_SECRET for local dev.
JWT_SECRET=dev-secret
# Required: token returned by researcher/admin token endpoint
# Required: auth session TTL in seconds
AUTH_SESSION_EXPIRY_SECONDS=604800
# Required: magic-link TTL in seconds
MAGIC_LINK_EXPIRY_SECONDS=900
# Required: case token TTL in seconds
CASE_TOKEN_EXPIRY_SECONDS=691200
# Required: JWT issuer used for case tokens
TOKEN_ISSUER=wearables-bff

# Admin bootstrap (comma-separated email addresses)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# External Database API Configuration
# Required even in mock mode for strict startup configuration
DATABASE_API_URL=http://localhost:8000
DATABASE_API_TIMEOUT=30000
# Optional: extraction service, served at ${API_PREFIX}/extraction (incl. Swagger UI at /docs)
# for researchers/admins and their personal API tokens. Leave empty to disable.
EXTRACTION_API_URL=http://localhost:8010

# Feature Flag - set to true to use mock data instead of real API
USE_MOCK_DATA=true

# Logging
# trace | debug | info | warn | error
LOG_LEVEL=debug

# Mailer Configuration
# Mailer is active only when NODE_ENV=production
MAILER_FROM_NAME=Wearables Platform
# Email address used in the 'From' field; must be a verified sender in Brevo
MAILER_FROM_EMAIL=email@example.com
# Your Brevo API key; required when NODE_ENV=production
BREVO_API_KEY=
