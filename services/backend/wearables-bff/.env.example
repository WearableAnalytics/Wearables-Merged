# Server Configuration
PORT=3001
# Set to `production` in production environments
NODE_ENV=development
API_PREFIX=/api

# Frontend Configuration
# Required: allowed CORS origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081
# Required: single frontend base URL for redirects (magic link + approval/login links)
FRONTEND_REDIRECT_URL=http://localhost:5173

# Backend Configuration
# Required: absolute backend URL used to build magic-link verification links
BACKEND_URL=http://localhost:3001

# JWT Configuration
# Required in production; required in non-mock mode
JWT_SECRET=dev-secret
# Required: token returned by researcher/admin token endpoint
RESEARCHER_API_ACCESS_TOKEN=dummy-researcher-api-token
# Optional: auth session TTL in seconds (default: 604800 / 7 days)
AUTH_SESSION_EXPIRY_SECONDS=604800
# Optional: magic-link TTL in seconds (default: 900 / 15 minutes)
MAGIC_LINK_EXPIRY_SECONDS=900
# Optional: case token TTL in seconds (default: 691200 / 8 days)
CASE_TOKEN_EXPIRY_SECONDS=691200
# Optional: JWT issuer used for case tokens (default: wearables-bff)
TOKEN_ISSUER=wearables-bff

# Admin bootstrap (comma-separated email addresses)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# External Database API Configuration
# Required even in mock mode for strict startup configuration
DATABASE_API_URL=http://localhost:8000
DATABASE_API_TIMEOUT=30000

# Feature Flag - set to true to use mock data instead of real API
USE_MOCK_DATA=true

# Logging
# trace | debug | info | warn | error
LOG_LEVEL=debug

# Mailer Configuration
# Mailer is active only when NODE_ENV=production
MAILER_FROM_NAME=Wearables Platform
# Email address used in the 'From' field; must be a verified sender in Brevo
MAILER_FROM_EMAIL=email@example.com
# Your Brevo API key; required when NODE_ENV=production
BREVO_API_KEY=
