# Runtime config fallbacks (used in browser by src/config/runtimeConfig.ts)

# API base path fallback for API_BASE_URL.
VITE_API_BASE_URL=/api

# Grafana proxy base path fallback for GRAFANA_PROXY_URL.
VITE_GRAFANA_PROXY_URL=/grafana

# Socket server URL fallback for SOCKET_URL.
# Set empty to use same-origin socket connection in the browser.
VITE_SOCKET_URL=http://localhost:3001

# Dev-only Vite proxy targets (used by vite.config.ts during npm run dev*)

# Backend origin Vite uses as target for VITE_API_BASE_URL path.
VITE_BACKEND_URL=http://localhost:3001

# Grafana origin Vite uses as target for VITE_GRAFANA_PROXY_URL path.
VITE_GRAFANA_PROXY_BACKEND_URL=http://localhost:3002
