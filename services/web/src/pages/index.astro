---
const highlights = [
  { title: 'Live vitals', body: 'Continuous streams from wearables are unified and normalized in real time.' },
  { title: 'Clinical signals', body: 'Surface anomalies, trends, and alerts that clinicians can act on quickly.' },
  { title: 'Privacy-first', body: 'Zero-knowledge storage options and audited access for every session.' },
];

const steps = [
  { label: '01', title: 'Connect', body: 'Securely connect every wearable vendor in minutes with built-in SSO.' },
  { label: '02', title: 'Observe', body: 'Real-time dashboards for clinicians, care teams, and operations.' },
  { label: '03', title: 'Intervene', body: 'Trigger playbooks, notify teams, and close the loop inside the app.' },
];
---

<main class="page">
  <div class="glow"></div>
  <header class="nav">
    <div class="brand">
      <div class="dot"></div>
      <span>Wearables Console</span>
    </div>
    <div class="nav-actions">
      <a href="#how">How it works</a>
      <a href="#features">Features</a>
      <button class="ghost" data-action="launch-app">Open console</button>
    </div>
  </header>

  <section class="hero">
    <div class="hero-copy">
      <p class="pill">Continuous patient signal</p>
      <h1>
        Precision monitoring
        <span class="gradient">for every bed</span>
      </h1>
      <p class="lede">
        We turn noisy wearable streams into calm, clinical clarity. Cohesive data, actionable alerts,
        and a console built for care teams who cannot afford to miss a beat.
      </p>
      <div class="meta">
        <div>
          <p class="eyebrow">Latency</p>
          <p class="metric">sub-2s</p>
        </div>
        <div>
          <p class="eyebrow">Coverage</p>
          <p class="metric">24/7</p>
        </div>
        <div>
          <p class="eyebrow">Deploy</p>
          <p class="metric">cloud / edge</p>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header">
        <div>
          <p class="eyebrow">Register / Login</p>
          <h2>SSO access in seconds</h2>
          <p class="muted">Preview the console instantly—no email required.</p>
        </div>
        <button class="chip">SOC2 ready</button>
      </div>
      <div class="launch-actions">
        <p class="helper">One click to enter the console experience.</p>
        <button class="primary" data-action="launch-app">Enter console</button>
      </div>
      <div class="chips">
        <span>Streamed vitals</span>
        <span>Audit-ready</span>
        <span>FHIR exports</span>
        <span>On-call routing</span>
      </div>
    </div>
  </section>

  <section class="grid" id="features">
    {highlights.map((item) => (
      <article class="card">
        <div class="badge">{item.title}</div>
        <p>{item.body}</p>
      </article>
    ))}
  </section>

  <section class="timeline" id="how">
    <div class="timeline-copy">
      <p class="pill">How it works</p>
      <h3>Built for teams who need reliable signals, not raw data.</h3>
      <p class="muted">
        Every stream is normalized, encrypted, and labeled before it reaches your clinicians. Alert fatigue drops,
        response time shrinks, and patients stay seen.
      </p>
    </div>
    <div class="steps">
      {steps.map((step) => (
        <div class="step">
          <span class="step-id">{step.label}</span>
          <div>
            <p class="step-title">{step.title}</p>
            <p class="muted">{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta">
    <div>
      <p class="pill">Ready when you are</p>
      <h3>Jump into the console and see live patient data.</h3>
      <p class="muted">One click to the console. No waiting for approvals.</p>
    </div>
    <div class="cta-actions">
      <button class="ghost" data-action="launch-app">Open console</button>
      <a class="text-link" href="#features">Explore features</a>
    </div>
  </section>
</main>

<script>
  const triggers = document.querySelectorAll('[data-action="launch-app"]');

  const goToApp = () => {
    window.location.href = './app';
  };

  triggers.forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      goToApp();
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

  :global(body) {
    margin: 0;
    font-family: 'Manrope', 'Inter', system-ui, -apple-system, sans-serif;
    color: #0b162a;
    background: #04060b;
  }

  :global(*) {
    box-sizing: border-box;
  }

  .page {
    min-height: 100vh;
    position: relative;
    padding: 32px clamp(20px, 5vw, 48px) 80px;
    background: radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.15), transparent 25%),
      radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.18), transparent 28%),
      linear-gradient(135deg, #04060b 0%, #0b1221 60%, #0d172f 100%);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.04), transparent 40%),
      radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.12), transparent 35%);
    filter: blur(14px);
    pointer-events: none;
  }

  .nav {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 0.02em;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, #22d3ee, #60a5fa);
    box-shadow: 0 0 0 6px rgba(96, 165, 250, 0.15);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-actions a {
    color: #cbd5e1;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }

  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
    align-items: center;
  }

  .hero-copy h1 {
    margin: 8px 0 12px;
    font-size: clamp(38px, 6vw, 56px);
    color: #f8fafc;
    line-height: 1.08;
  }

  .gradient {
    display: inline-block;
    background: linear-gradient(120deg, #34d399, #22d3ee, #a855f7);
    -webkit-background-clip: text;
    color: transparent;
  }

  .lede {
    color: #cbd5e1;
    max-width: 560px;
    margin: 0 0 18px;
    font-size: 17px;
    line-height: 1.7;
  }

  .meta {
    display: flex;
    gap: 22px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    backdrop-filter: blur(4px);
    width: fit-content;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    color: #94a3b8;
    margin: 0 0 4px;
  }

  .metric {
    margin: 0;
    color: #e2e8f0;
    font-weight: 700;
    font-size: 18px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .panel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 22px;
    backdrop-filter: blur(8px);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.35);
  }

  .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .panel-header h2 {
    margin: 4px 0;
    color: #f8fafc;
  }

  .muted {
    margin: 0;
    color: #94a3b8;
    line-height: 1.6;
  }

  .chip {
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-weight: 600;
  }

  .launch-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .primary {
    padding: 12px 16px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(135deg, #22d3ee, #60a5fa);
    color: #0b1221;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 0.01em;
  }

  .helper {
    margin: 0;
    color: #94a3b8;
    font-size: 13px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .chips span {
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-size: 13px;
  }

  .grid {
    position: relative;
    z-index: 1;
    margin: 36px 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }

  .card {
    padding: 18px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    color: #cbd5e1;
    box-shadow: 0 12px 38px rgba(0, 0, 0, 0.22);
  }

  .badge {
    display: inline-flex;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(96, 165, 250, 0.12);
    color: #e2e8f0;
    font-weight: 700;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .timeline {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    align-items: center;
    padding: 26px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .timeline h3 {
    margin: 8px 0 12px;
    color: #f8fafc;
    font-size: clamp(24px, 4vw, 32px);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: center;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }

  .step-id {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: linear-gradient(135deg, #22d3ee, #60a5fa);
    color: #0b1221;
    font-weight: 800;
  }

  .step-title {
    margin: 0 0 4px;
    color: #e2e8f0;
    font-weight: 700;
  }

  .cta {
    position: relative;
    z-index: 1;
    margin-top: 40px;
    padding: 22px 24px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.12), rgba(96, 165, 250, 0.08));
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    align-items: center;
  }

  .cta h3 {
    margin: 6px 0 4px;
    color: #0b1221;
  }

  .cta .muted {
    color: #0b1221;
    opacity: 0.8;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: flex-end;
  }

  .ghost {
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
    font-weight: 700;
    cursor: pointer;
  }

  .text-link {
    color: #0b1221;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .nav-actions {
      gap: 10px;
    }

    .cta-actions {
      justify-content: flex-start;
    }
  }
</style>
