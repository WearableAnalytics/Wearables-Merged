---
const productPoints = [
  {
    title: 'What it is',
    body: 'One place that connects any wearable, streams data instantly, and keeps it secure end-to-end.',
  },
  {
    title: 'What it does',
    body: 'Converts raw signals into clear patient stories-live vitals, trends, and meaningful alerts you can act on now.',
  },
  {
    title: 'Where it shows up',
    body: 'A web app for clinicians, ready-made Grafana dashboards for oversight, and a companion app that links devices to the platform in minutes.',
  },
];

const personas = [
  {
    title: 'For practitioners',
    items: [
      'Run assessments like the six-minute walk test.',
      'Monitor patients continuously with calm, reliable views.',
      'Get alerted before small issues become big ones.',
    ],
  },
  {
    title: 'For researchers',
    items: [
      'Explore rich, longitudinal datasets with built-in insights.',
      'Visualize trends without wrangling-just analysis.',
      'Export what you need while keeping data protected.',
    ],
  },
];

const scalePoints = [
  'Built to stay fast and reliable as data grows.',
  'Delivers real-time views and ML-driven signals without slowing down.',
  'Security stays intact from device to dashboard.',
];

import '../styles/tailwind.css';
---

<main class="relative min-h-screen overflow-hidden bg-[#f7fbff] text-[#0d1f3b] px-[clamp(20px,5vw,56px)] pt-7 pb-20 font-sans">
  <div class="pointer-events-none absolute inset-0">
    <span class="absolute -top-20 -left-28 h-[360px] w-[360px] rounded-full blur-[40px] opacity-55 bg-[radial-gradient(circle,rgba(12,157,216,0.26),transparent_60%)]"></span>
    <span class="absolute bottom-[10%] right-[12%] h-[280px] w-[280px] rounded-full blur-[40px] opacity-55 bg-[radial-gradient(circle,rgba(38,198,184,0.32),transparent_60%)]"></span>
    <span class="absolute -bottom-10 left-[22%] h-[220px] w-[220px] rounded-full blur-[40px] opacity-55 bg-[radial-gradient(circle,rgba(12,157,216,0.18),transparent_55%)]"></span>
  </div>

  <header class="relative z-10 mb-8 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="relative grid h-[42px] w-[42px] place-items-center overflow-hidden rounded-[12px] bg-[linear-gradient(135deg,rgba(12,157,216,0.1),rgba(38,198,184,0.2))]">
        <span class="absolute h-[10px] w-[70%] rounded-full bg-[linear-gradient(135deg,#0c9dd8,#26c6b8)]"></span>
        <span class="absolute h-[70%] w-[10px] rounded-full bg-[linear-gradient(135deg,#0c9dd8,#26c6b8)]"></span>
      </div>
      <div>
        <p class="m-0 text-[11px] uppercase tracking-[0.12em] font-bold text-[#5a6c82]">Wearables</p>
        <p class="m-[2px_0_0] text-[18px] font-bold tracking-[0.01em]">Clinical Platform</p>
      </div>
    </div>
    <div class="flex items-center gap-[14px] text-[14px] font-semibold text-[#5a6c82]">
      <a class="transition hover:text-[#0d1f3b]" href="#product">Product</a>
      <a class="transition hover:text-[#0d1f3b]" href="#personas">Teams</a>
      <button
        class="rounded-full border border-[#e6eef6] bg-white/90 px-[14px] py-[10px] font-bold text-[#0d1f3b] shadow-[0_6px_20px_rgba(12,157,216,0.12)] transition hover:-translate-y-[1px]"
        data-action="launch-app"
      >
        Access App
      </button>
    </div>
  </header>

  <section class="relative z-10 grid items-center gap-[30px] lg:grid-cols-2">
    <div class="flex flex-col gap-3">
      <p class="inline-flex items-center gap-2 rounded-full border border-[#e6eef6] bg-white px-3 py-2 text-[13px] text-[#5a6c82] tracking-[0.01em]">
        Real-time wearables platform for care and research.
      </p>
      <h1 class="mt-2 mb-3 text-[clamp(36px,5vw,56px)] leading-[1.08] font-bold">
        Calm, clinical insight from every wearable-without extra work.
      </h1>
      <p class="mb-[18px] text-[17px] leading-[1.65] text-[#5a6c82]">
        One modern surface to connect devices, see live vitals, and act fast. Built for hospitals and research teams who
        need clarity, not dashboards full of noise.
      </p>
      <div class="mb-3 flex flex-wrap items-center gap-[14px]">
        <button
          class="rounded-xl border-0 bg-[linear-gradient(120deg,#0c9dd8,#26c6b8)] px-[18px] py-3 font-extrabold text-white shadow-[0_14px_36px_rgba(12,157,216,0.22)] transition hover:-translate-y-[2px] hover:shadow-[0_18px_48px_rgba(12,157,216,0.28)]"
          data-action="launch-app"
        >
          Access App
        </button>
        <a class="border-b border-[rgba(12,157,216,0.3)] pb-[2px] font-bold text-[#0d1f3b]" href="#product">See how it works</a>
      </div>
      <div class="mt-2 flex flex-wrap gap-2">
        <span class="rounded-full border border-[#e6eef6] bg-[rgba(13,31,59,0.03)] px-[10px] py-2 text-[13px] text-[#5a6c82]">Streamed vitals</span>
        <span class="rounded-full border border-[#e6eef6] bg-[rgba(13,31,59,0.03)] px-[10px] py-2 text-[13px] text-[#5a6c82]">Secure end-to-end</span>
        <span class="rounded-full border border-[#e6eef6] bg-[rgba(13,31,59,0.03)] px-[10px] py-2 text-[13px] text-[#5a6c82]">Clinician-friendly</span>
        <span class="rounded-full border border-[#e6eef6] bg-[rgba(13,31,59,0.03)] px-[10px] py-2 text-[13px] text-[#5a6c82]">Research-ready</span>
      </div>
    </div>

    <div class="flex flex-col gap-4 rounded-[20px] border border-[#e6eef6] bg-white/90 p-5 shadow-[0_30px_70px_rgba(13,31,59,0.12)] backdrop-blur">
      <div>
        <p class="m-0 text-[11px] uppercase tracking-[0.12em] font-bold text-[#5a6c82]">Instant signal</p>
        <h3 class="m-[4px_0] text-[22px] font-semibold">Live stories from raw data</h3>
        <p class="m-0 text-[#5a6c82] leading-[1.6]">
          Convert raw signals into live vitals, trends, and alerts you can act on now.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-3 rounded-[14px] bg-[linear-gradient(120deg,rgba(12,157,216,0.08),rgba(38,198,184,0.07))] p-3 sm:grid-cols-3">
        <div class="flex flex-col gap-1">
          <p class="m-0 text-[22px] font-extrabold text-[#0d1f3b]">1.8s</p>
          <p class="m-0 text-[13px] text-[#5a6c82]">Stream latency</p>
        </div>
        <div class="flex flex-col gap-1">
          <p class="m-0 text-[22px] font-extrabold text-[#0d1f3b]">24/7</p>
          <p class="m-0 text-[13px] text-[#5a6c82]">Continuous coverage</p>
        </div>
        <div class="flex flex-col gap-1">
          <p class="m-0 text-[22px] font-extrabold text-[#0d1f3b]">Grafana</p>
          <p class="m-0 text-[13px] text-[#5a6c82]">Dashboards included</p>
        </div>
      </div>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="m-0 text-[11px] uppercase tracking-[0.12em] font-bold text-[#5a6c82]">Fast setup</p>
          <p class="m-0 text-[#5a6c82]">Link devices to the platform in minutes-no new hardware.</p>
        </div>
        <button
          class="rounded-xl border border-[#e6eef6] bg-[#f7fbff] px-[14px] py-[10px] font-bold text-[#0d1f3b] shadow-[0_10px_24px_rgba(13,31,59,0.12)] transition hover:-translate-y-[1px]"
          data-action="launch-app"
        >
          Access App
        </button>
      </div>
    </div>
  </section>

  <section id="product" class="relative z-10 mt-[50px] mb-[18px] grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-[14px]">
    {productPoints.map((item) => (
      <article class="rounded-[14px] border border-[#e6eef6] bg-white/90 p-[18px] shadow-[0_18px_42px_rgba(13,31,59,0.08)]">
        <p class="m-0 mb-2 font-bold text-[#0d1f3b]">{item.title}</p>
        <p class="m-0 text-[#5a6c82] leading-[1.6]">{item.body}</p>
      </article>
    ))}
  </section>

  <section id="personas" class="relative z-10 my-[46px] flex flex-col gap-[18px]">
    <div class="max-w-[760px]">
      <p class="inline-flex items-center gap-2 rounded-full border border-[rgba(12,157,216,0.14)] bg-[rgba(12,157,216,0.08)] px-3 py-2 text-[13px] text-[#0c5c89]">
        Built for the teams who rely on it
      </p>
      <h2 class="mt-[6px] mb-3 text-[clamp(26px,4vw,34px)] font-semibold">From bedside to bench-one platform stays in sync.</h2>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-4">
      {personas.map((persona) => (
        <article class="rounded-[16px] border border-[rgba(12,157,216,0.12)] bg-[linear-gradient(180deg,rgba(12,157,216,0.04),rgba(255,255,255,0.94))] p-[18px] shadow-[0_20px_46px_rgba(13,31,59,0.08)]">
          <p class="m-0 mb-2 font-bold text-[#0d1f3b]">{persona.title}</p>
          <ul class="mt-2 list-disc space-y-2 pl-[18px] text-[#5a6c82] leading-[1.6]">
            {persona.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="relative z-10 my-10 rounded-[18px] border border-[#e6eef6] bg-white p-6 shadow-[0_26px_60px_rgba(13,31,59,0.1)]">
    <div class="max-w-[760px]">
      <p class="inline-flex items-center gap-2 rounded-full border border-[rgba(12,157,216,0.14)] bg-[rgba(12,157,216,0.08)] px-3 py-2 text-[13px] text-[#0c5c89]">
        Why it scales
      </p>
      <h2 class="mt-[6px] mb-3 text-[clamp(26px,4vw,34px)] font-semibold">Stays fast, secure, and reliable as data grows.</h2>
      <p class="m-0 text-[#5a6c82] leading-[1.6]">
        Real-time views and ML-driven signals arrive without lag, while privacy holds from device to dashboard.
      </p>
    </div>
    <div class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-3">
      {scalePoints.map((point) => (
        <div class="grid grid-cols-[auto_1fr] items-start gap-3 border-t border-[#e6eef6] py-[10px] first:border-t-0">
          <span class="mt-1 inline-block h-3 w-3 rounded-full bg-[linear-gradient(135deg,#0c9dd8,#26c6b8)]"></span>
          <p class="m-0 text-[#0d1f3b]">{point}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="relative z-10 mt-9 grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] items-center gap-4 rounded-[18px] border border-[rgba(12,157,216,0.18)] bg-[linear-gradient(130deg,rgba(12,157,216,0.1),rgba(38,198,184,0.1))] px-[22px] py-[24px]">
    <div class="space-y-2">
      <p class="inline-flex items-center gap-2 rounded-full border border-[rgba(12,157,216,0.14)] bg-[rgba(12,157,216,0.08)] px-3 py-2 text-[13px] text-[#0c5c89]">
        Ready to see it live?
      </p>
      <h3 class="m-0 text-[22px] font-semibold">Access the app, connect a device, and watch the story form in real time.</h3>
      <p class="m-0 text-[#5a6c82]">No extra setup. Just the stream, the insights, and the alerts your team needs.</p>
    </div>
    <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
      <button
        class="rounded-xl border-0 bg-[linear-gradient(120deg,#0c9dd8,#26c6b8)] px-[18px] py-3 font-extrabold text-white shadow-[0_14px_36px_rgba(12,157,216,0.22)] transition hover:-translate-y-[2px] hover:shadow-[0_18px_48px_rgba(12,157,216,0.28)]"
        data-action="launch-app"
      >
        Access App
      </button>
      <a class="border-b border-[rgba(12,157,216,0.3)] pb-[2px] font-bold text-[#0d1f3b]" href="#personas">Meet the workflows</a>
    </div>
  </section>
</main>

<script>
  const triggers = document.querySelectorAll('[data-action="launch-app"]');

  const goToApp = () => {
    window.location.href = './app';
  };

  triggers.forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      goToApp();
    });
  });
</script>
