---
const productPoints = [
  {
    title: 'What it is',
    body: 'One place that connects any wearable, streams data instantly, and keeps it secure end-to-end.',
  },
  {
    title: 'What it does',
    body: 'Converts raw signals into clear patient stories-live vitals, trends, and meaningful alerts you can act on now.',
  },
  {
    title: 'Where it shows up',
    body: 'A web app for clinicians, ready-made Grafana dashboards for oversight, and a companion app that links devices to the platform in minutes.',
  },
];

const personas = [
  {
    title: 'For practitioners',
    items: [
      'Run assessments like the six-minute walk test.',
      'Monitor patients continuously with calm, reliable views.',
      'Get alerted before small issues become big ones.',
    ],
  },
  {
    title: 'For researchers',
    items: [
      'Explore rich, longitudinal datasets with built-in insights.',
      'Visualize trends without wrangling-just analysis.',
      'Export what you need while keeping data protected.',
    ],
  },
];

const scalePoints = [
  'Built to stay fast and reliable as data grows.',
  'Delivers real-time views and ML-driven signals without slowing down.',
  'Security stays intact from device to dashboard.',
];
---

<main class="page">
  <div class="ambient">
    <span class="orb orb-a"></span>
    <span class="orb orb-b"></span>
    <span class="orb orb-c"></span>
  </div>

  <header class="nav">
    <div class="brand">
      <div class="mark">
        <span></span>
        <span></span>
      </div>
      <div>
        <p class="eyebrow">Wearables</p>
        <p class="brand-name">Clinical Platform</p>
      </div>
    </div>
    <div class="nav-actions">
      <a href="#product">Product</a>
      <a href="#personas">Teams</a>
      <button class="outline" data-action="launch-app">Access App</button>
    </div>
  </header>

  <section class="hero">
    <div class="hero-copy">
      <p class="pill">Real-time wearables platform for care and research.</p>
      <h1>
        Calm, clinical insight from every wearable-without extra work.
      </h1>
      <p class="lede">
        One modern surface to connect devices, see live vitals, and act fast. Built for hospitals and research teams who
        need clarity, not dashboards full of noise.
      </p>
      <div class="hero-actions">
        <button class="primary" data-action="launch-app">Access App</button>
        <a class="link" href="#product">See how it works</a>
      </div>
      <div class="tags">
        <span>Streamed vitals</span>
        <span>Secure end-to-end</span>
        <span>Clinician-friendly</span>
        <span>Research-ready</span>
      </div>
    </div>

    <div class="hero-panel">
      <div class="panel-header">
        <p class="eyebrow">Instant signal</p>
        <h3>Live stories from raw data</h3>
        <p class="muted">
          Convert raw signals into live vitals, trends, and alerts you can act on now.
        </p>
      </div>
      <div class="panel-body">
        <div class="stat">
          <p class="stat-value">1.8s</p>
          <p class="stat-label">Stream latency</p>
        </div>
        <div class="stat">
          <p class="stat-value">24/7</p>
          <p class="stat-label">Continuous coverage</p>
        </div>
        <div class="stat">
          <p class="stat-value">Grafana</p>
          <p class="stat-label">Dashboards included</p>
        </div>
      </div>
      <div class="panel-footer">
        <div>
          <p class="eyebrow">Fast setup</p>
          <p class="muted">Link devices to the platform in minutes-no new hardware.</p>
        </div>
        <button class="ghost" data-action="launch-app">Access App</button>
      </div>
    </div>
  </section>

  <section id="product" class="product">
    {productPoints.map((item) => (
      <article class="card">
        <p class="card-title">{item.title}</p>
        <p class="muted">{item.body}</p>
      </article>
    ))}
  </section>

  <section id="personas" class="personas">
    <div class="section-head">
      <p class="pill soft">Built for the teams who rely on it</p>
      <h2>From bedside to bench-one platform stays in sync.</h2>
    </div>
    <div class="persona-grid">
      {personas.map((persona) => (
        <article class="persona-card">
          <p class="card-title">{persona.title}</p>
          <ul>
            {persona.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="scale">
    <div class="section-head">
      <p class="pill soft">Why it scales</p>
      <h2>Stays fast, secure, and reliable as data grows.</h2>
      <p class="muted">
        Real-time views and ML-driven signals arrive without lag, while privacy holds from device to dashboard.
      </p>
    </div>
    <div class="scale-grid">
      {scalePoints.map((point) => (
        <div class="scale-item">
          <span class="dot"></span>
          <p>{point}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="cta">
    <div>
      <p class="pill soft">Ready to see it live?</p>
      <h3>Access the app, connect a device, and watch the story form in real time.</h3>
      <p class="muted">No extra setup. Just the stream, the insights, and the alerts your team needs.</p>
    </div>
    <div class="cta-actions">
      <button class="primary" data-action="launch-app">Access App</button>
      <a class="link" href="#personas">Meet the workflows</a>
    </div>
  </section>
</main>

<script>
  const triggers = document.querySelectorAll('[data-action="launch-app"]');

  const goToApp = () => {
    window.location.href = './app';
  };

  triggers.forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      goToApp();
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    font-family: 'Sora', 'Inter', system-ui, -apple-system, sans-serif;
    color: #0d1f3b;
    background: #f7fbff;
    -webkit-font-smoothing: antialiased;
  }

  :root {
    --ink: #0d1f3b;
    --accent: #0c9dd8;
    --mint: #26c6b8;
    --line: #e6eef6;
    --muted: #5a6c82;
  }

  .page {
    min-height: 100vh;
    position: relative;
    padding: 28px clamp(20px, 5vw, 56px) 80px;
    overflow: hidden;
  }

  .ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    filter: blur(40px);
    border-radius: 50%;
    opacity: 0.55;
  }

  .orb-a {
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(12, 157, 216, 0.26), transparent 60%);
    top: -80px;
    left: -120px;
  }

  .orb-b {
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(38, 198, 184, 0.32), transparent 60%);
    bottom: 10%;
    right: 12%;
  }

  .orb-c {
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, rgba(12, 157, 216, 0.18), transparent 55%);
    bottom: -40px;
    left: 22%;
  }

  .nav {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(12, 157, 216, 0.1), rgba(38, 198, 184, 0.2));
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }

  .mark span {
    position: absolute;
    background: linear-gradient(135deg, #0c9dd8, #26c6b8);
    border-radius: 999px;
  }

  .mark span:first-child {
    width: 70%;
    height: 10px;
  }

  .mark span:last-child {
    width: 10px;
    height: 70%;
  }

  .brand-name {
    margin: 2px 0 0;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.01em;
  }

  .eyebrow {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 700;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .nav-actions a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }

  .outline {
    padding: 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.9);
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .outline:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(12, 157, 216, 0.12);
  }

  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    align-items: center;
  }

  h1 {
    font-size: clamp(36px, 5vw, 56px);
    margin: 10px 0 12px;
    line-height: 1.08;
  }

  h2 {
    margin: 6px 0 12px;
    font-size: clamp(26px, 4vw, 34px);
  }

  h3 {
    margin: 8px 0 6px;
    font-size: 22px;
  }

  .lede {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
    max-width: 640px;
    margin: 0 0 18px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.01em;
  }

  .pill.soft {
    background: rgba(12, 157, 216, 0.08);
    border-color: rgba(12, 157, 216, 0.14);
    color: #0c5c89;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }

  .primary {
    padding: 12px 18px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(120deg, #0c9dd8, #26c6b8);
    color: white;
    font-weight: 800;
    cursor: pointer;
    letter-spacing: 0.01em;
    box-shadow: 0 14px 36px rgba(12, 157, 216, 0.22);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 48px rgba(12, 157, 216, 0.28);
  }

  .link {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(12, 157, 216, 0.3);
    padding-bottom: 2px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .tags span {
    padding: 8px 10px;
    border-radius: 999px;
    background: rgba(13, 31, 59, 0.03);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  .hero-panel {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line);
    box-shadow: 0 30px 70px rgba(13, 31, 59, 0.12);
    border-radius: 20px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    backdrop-filter: blur(6px);
  }

  .panel-header h3 {
    margin: 4px 0;
  }

  .muted {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .panel-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    padding: 12px;
    border-radius: 14px;
    background: linear-gradient(120deg, rgba(12, 157, 216, 0.08), rgba(38, 198, 184, 0.07));
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    color: var(--ink);
  }

  .stat-label {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }

  .panel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
  }

  .ghost {
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #f7fbff;
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .ghost:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px rgba(13, 31, 59, 0.12);
  }

  .product {
    position: relative;
    z-index: 1;
    margin: 50px 0 18px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .card {
    padding: 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--line);
    box-shadow: 0 18px 42px rgba(13, 31, 59, 0.08);
  }

  .card-title {
    margin: 0 0 8px;
    font-weight: 700;
    color: var(--ink);
  }

  .personas {
    position: relative;
    z-index: 1;
    margin: 46px 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .section-head {
    max-width: 760px;
  }

  .persona-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .persona-card {
    padding: 18px 18px 14px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(12, 157, 216, 0.04), rgba(255, 255, 255, 0.94));
    border: 1px solid rgba(12, 157, 216, 0.12);
    box-shadow: 0 20px 46px rgba(13, 31, 59, 0.08);
  }

  .persona-card ul {
    margin: 8px 0 0;
    padding-left: 18px;
    color: var(--muted);
    line-height: 1.6;
  }

  .persona-card li {
    margin-bottom: 8px;
  }

  .scale {
    position: relative;
    z-index: 1;
    margin: 40px 0;
    padding: 24px;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid var(--line);
    box-shadow: 0 26px 60px rgba(13, 31, 59, 0.1);
  }

  .scale-grid {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }

  .scale-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: flex-start;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }

  .scale-item:first-child {
    border-top: none;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0c9dd8, #26c6b8);
    display: inline-block;
    margin-top: 4px;
  }

  .cta {
    position: relative;
    z-index: 1;
    margin-top: 36px;
    padding: 22px 22px 24px;
    border-radius: 18px;
    background: linear-gradient(130deg, rgba(12, 157, 216, 0.1), rgba(38, 198, 184, 0.1));
    border: 1px solid rgba(12, 157, 216, 0.18);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    align-items: center;
  }

  .cta h3 {
    margin: 6px 0 6px;
  }

  .cta-actions {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .nav-actions {
      width: 100%;
      justify-content: space-between;
    }

    .panel-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
